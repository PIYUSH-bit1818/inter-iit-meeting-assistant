# Copy to .env and fill in. Never commit .env.

# --- Speech-to-text (Groq Whisper) ---
# Required. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides (defaults shown)
# STT_MODEL=whisper-large-v3
# STT_LANGUAGE=en
# Per-request upload limit in MB: 25 on Groq's free tier, 100 on the dev tier.
# Long recordings are split into chunks that stay under this limit.
# GROQ_MAX_REQUEST_MB=25
# STT_REQUEST_TIMEOUT_SECONDS=300

# --- Transcript refinement (Google Gemini) ---
# Required. Create a free key at https://aistudio.google.com/apikey
# (no billing account needed for the free tier)
GEMINI_API_KEY=
# Optional overrides (defaults shown). Leave commented out rather than empty.
# REFINE_MODEL=gemini-3.6-flash
# Comma-separated models to try if the primary is overloaded (HTTP 503/429)
# REFINE_FALLBACK_MODELS=
# Gemini 3 thinking level: minimal | low | medium | high
# REFINE_THINKING_LEVEL=low
# REFINE_RETRY_ATTEMPTS=4
# REFINE_TIMEOUT_SECONDS=300
# REFINE_MAX_WORDS_PER_REQUEST=1500

# --- Meeting documentation (Google Gemini, LLM #2) ---
# Uses the same GEMINI_API_KEY but must be a different model from REFINE_MODEL.
# Optional overrides (defaults shown). Leave commented out rather than empty.
# DOCUMENT_MODEL=gemini-3-flash-preview
# DOCUMENT_FALLBACK_MODELS=gemini-3.5-flash-lite
# DOCUMENT_THINKING_LEVEL=medium
# DOCUMENT_RETRY_ATTEMPTS=4
# DOCUMENT_TIMEOUT_SECONDS=300

# --- App ---
DATA_DIR=data
MAX_UPLOAD_MB=100
# URL the Streamlit frontend uses to reach the FastAPI backend
BACKEND_URL=http://localhost:8000
