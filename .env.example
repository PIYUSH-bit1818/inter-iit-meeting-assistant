# Copy to .env and fill in. Never commit .env.

# --- Speech-to-text (Groq) ---
GROQ_API_KEY=
# Groq transcription model ID (verify against Groq's model list before use)
STT_MODEL=

# --- LLMs (Anthropic API key - separate from any Claude Pro subscription) ---
ANTHROPIC_API_KEY=
# Model IDs are intentionally left blank: they will be verified against the
# Anthropic Models API before the LLM stages are implemented.
REFINE_MODEL=
DOCUMENT_MODEL=

# --- App ---
DATA_DIR=data
MAX_UPLOAD_MB=100
# URL the Streamlit frontend uses to reach the FastAPI backend
BACKEND_URL=http://localhost:8000
