# Copy to .env and fill in. Never commit .env.

# --- Speech-to-text (Groq Whisper) ---
# Required. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides (defaults shown)
# STT_MODEL=whisper-large-v3
# STT_LANGUAGE=en
# Per-request upload limit in MB: 25 on Groq's free tier, 100 on the dev tier.
# Long recordings are split into chunks that stay under this limit.
# GROQ_MAX_REQUEST_MB=25
# STT_REQUEST_TIMEOUT_SECONDS=300

# --- LLMs (Anthropic API key - separate from any Claude Pro subscription) ---
ANTHROPIC_API_KEY=
# Model IDs are intentionally left blank: they will be verified against the
# Anthropic Models API before the LLM stages are implemented.
REFINE_MODEL=
DOCUMENT_MODEL=

# --- App ---
DATA_DIR=data
MAX_UPLOAD_MB=100
# URL the Streamlit frontend uses to reach the FastAPI backend
BACKEND_URL=http://localhost:8000
